TELEGRAM_TOKEN=your_bot_token_here
ALLOWED_USER_ID=your_telegram_user_id

# Логин от cryptorg.net (сайт)
CRYPTORG_EMAIL=your@email.com
CRYPTORG_PASSWORD=your_password
CRYPTORG_TRADE_PASSWORD=your_trade_pin

# Bybit API ключи (субаккаунт)
BYBIT_API_KEY=your_bybit_api_key
BYBIT_API_SECRET=your_bybit_api_secret

# База данных (для Railway volume: sqlite+aiosqlite:////data/cryptorg_bot.db)
DATABASE_URL=sqlite+aiosqlite:///cryptorg_bot.db

# Путь к JWT кэшу (для Railway volume: /data/.jwt_cache)
JWT_CACHE_PATH=cryptorg/.jwt_cache

# Интервал поллера в секундах
POLL_INTERVAL=30
